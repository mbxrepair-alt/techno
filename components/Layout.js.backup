"use client";

import { useEffect, useState } from "react";
import { supabase, getCurrentUser } from "../lib/supabase";
import { useRouter } from "next/navigation";
import Link from "next/link";
import Image from "next/image";

export default function Layout({ children }) {
  const router = useRouter();
  const [userEmail, setUserEmail] = useState("Chargement...");
  const [companyName, setCompanyName] = useState("");
  const [logoUrl, setLogoUrl] = useState("");
  const [isAdmin, setIsAdmin] = useState(false);
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [clientSubmissions, setClientSubmissions] = useState(0);
  const [settingsOpen, setSettingsOpen] = useState(false);
  
  // 👇 ÉTATS POUR LES TECHNICIENS
  const [technician, setTechnician] = useState(null);
  const [isTechnician, setIsTechnician] = useState(false);
  const [permissions, setPermissions] = useState({});

  useEffect(() => {
    // Vérifier d'abord si c'est un technicien connecté
    const tech = sessionStorage.getItem("technician");
    if (tech) {
      const techData = JSON.parse(tech);
      setTechnician(techData);
      setIsTechnician(true);
      setPermissions(techData.permissions || {});
      setUserEmail(techData.email);
      return;
    }
    
    // Sinon, vérifier l'utilisateur normal (gérant)
    const getUser = async () => {
      try {
        const user = await getCurrentUser();
        if (user) {
          setUserEmail(user.email);
          if (user.email === "mbxrepair@gmail.com") {
            setIsAdmin(true);
          }
          
          const { data: profile } = await supabase
            .from("profiles")
            .select("is_admin, company_name, logo_url")
            .eq("id", user.id)
            .single();
          
          if (profile?.is_admin) {
            setIsAdmin(true);
          }
          if (profile?.company_name) {
            setCompanyName(profile.company_name);
          }
          if (profile?.logo_url) {
            setLogoUrl(profile.logo_url);
          }
          
          const { count, error } = await supabase
            .from("repairs")
            .select("*", { count: 'exact', head: true })
            .eq("user_id", user.id)
            .eq("is_client_submitted", true);
          
          if (!error && count !== null) {
            setClientSubmissions(count);
          }
        } else {
          setUserEmail("Non connecté");
        }
      } catch (error) {
        console.error("Erreur chargement user:", error);
        setUserEmail("Erreur de chargement");
      }
    };
    getUser();
  }, []);

  const handleLogout = async () => {
    if (isTechnician) {
      sessionStorage.removeItem("technician");
    } else {
      await supabase.auth.signOut();
    }
    router.push("/login");
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 flex flex-col">
      {/* ========== HEADER NEON ULTRA MODERNE ========== */}
      <nav className="sticky top-0 z-50 bg-black/80 backdrop-blur-2xl border-b border-orange-500/40 shadow-[0_0_50px_rgba(249,115,22,0.2)]">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between items-center h-16">
            
            {/* Logo avec anneau rotatif effet lumineux */}
            <div className="flex items-center gap-3 cursor-pointer group" onClick={() => router.push("/dashboard")}>
              <div className="relative">
                <div className="absolute -inset-2 rounded-xl bg-gradient-to-r from-orange-500 via-orange-400 to-orange-600 opacity-75 group-hover:opacity-100 blur-md animate-spin-slow"></div>
                <div className="relative w-12 h-12 bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl flex items-center justify-center shadow-[0_0_20px_rgba(249,115,22,0.5)] overflow-hidden">
                  {logoUrl ? (
                    <Image
                      src={logoUrl}
                      alt="Logo MBXrepair"
                      width={48}
                      height={48}
                      className="object-contain rounded-lg"
                      priority
                      onError={() => setLogoUrl("")}
                    />
                  ) : (
                    <span className="text-white text-2xl font-bold drop-shadow-[0_0_5px_rgba(255,255,255,0.5)]">🔧</span>
                  )}
                </div>
              </div>
              <div>
                <h1 className="text-xl font-bold bg-gradient-to-r from-white to-orange-300 bg-clip-text text-transparent drop-shadow-[0_0_10px_rgba(249,115,22,0.3)]">
                  {companyName || "Mon Atelier"}
                </h1>
              </div>
            </div>

            {/* MENU DESKTOP - AVEC FILTRE PERMISSIONS */}
            <div className="hidden lg:flex items-center gap-1 bg-white/5 backdrop-blur-xl rounded-full p-1 border border-white/10 shadow-lg">
              {/* Dashboard */}
              {(!isTechnician || permissions.dashboard) && (
                <NavLink href="/dashboard">📊 Dashboard</NavLink>
              )}
              
              {/* Réparations */}
              {(!isTechnician || permissions.repairs) && (
                <NavLink href="/repairs">🔧 Réparations</NavLink>
              )}
              
              {/* Clients */}
              {(!isTechnician || permissions.clients) && (
                <NavLink href="/clients">👥 Clients</NavLink>
              )}
              
              {/* Historique */}
              {(!isTechnician || permissions.historique) && (
                <NavLink href="/historique">📜 Historique</NavLink>
              )}
              
              {/* Factures */}
              {(!isTechnician || permissions.factures) && (
                <NavLink href="/factures">💰 Factures</NavLink>
              )}
              
              {/* Paiements */}
              {(!isTechnician || permissions.paiements) && (
                <NavLink href="/paiements">💳 Paiements</NavLink>
              )}
              
              {/* Appareils saisis */}
              {(!isTechnician || permissions.client_submissions) && (
                <NavLink href="/admin/client-submissions">
                  📱 Appareils saisis
                  {clientSubmissions > 0 && (
                    <span className="ml-1 bg-orange-500 text-white text-xs px-1.5 py-0.5 rounded-full shadow-[0_0_8px_rgba(249,115,22,0.5)] animate-pulse">
                      {clientSubmissions}
                    </span>
                  )}
                </NavLink>
              )}
              
              {/* Espace client */}
              {(!isTechnician || permissions.client_space) && (
                <NavLink href="/client">🌍 Espace client</NavLink>
              )}
              
              {/* SOUS-MENU PARAMÈTRES */}
              {(!isTechnician || permissions.settings) && (
                <div className="relative">
                  <button
                    onClick={() => setSettingsOpen(!settingsOpen)}
                    className="relative px-3 py-1.5 rounded-full text-sm font-medium text-gray-300 hover:text-white transition-all duration-300 group/btn overflow-hidden"
                  >
                    <span className="absolute inset-0 bg-gradient-to-r from-orange-600 to-orange-500 opacity-0 group-hover/btn:opacity-100 transition-opacity duration-300 rounded-full"></span>
                    <span className="relative z-10 flex items-center gap-1">
                      ⚙️ Paramètres
                      <svg className={`w-3 h-3 transition-transform duration-200 ${settingsOpen ? 'rotate-180' : ''}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" />
                      </svg>
                    </span>
                  </button>
                  
                  {settingsOpen && (
                    <div className="absolute left-0 mt-2 w-56 bg-black/90 backdrop-blur-xl rounded-xl shadow-[0_0_30px_rgba(249,115,22,0.2)] border border-orange-500/30 py-2 z-50">
                      <div className="px-3 py-2 text-xs font-semibold text-orange-400 uppercase border-b border-orange-500/20">Gestion avancée</div>
                      {(!isTechnician || permissions.statistiques) && (
                        <Link href="/statistiques" className="block px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-orange-500/20 transition">📈 Statistiques</Link>
                      )}
                      {(!isTechnician || permissions.stock) && (
                        <Link href="/stock" className="block px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-orange-500/20 transition">📦 Stock</Link>
                      )}
                      {(!isTechnician || permissions.fournisseurs) && (
                        <Link href="/fournisseurs" className="block px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-orange-500/20 transition">🚚 Fournisseurs</Link>
                      )}
                      <div className="border-t border-orange-500/20 my-1"></div>
                      <Link href="/settings" className="block px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-orange-500/20 transition">⚙️ Paramètres généraux</Link>
                    </div>
                  )}
                </div>
              )}
              
              {/* SECTION ADMIN - UNIQUEMENT POUR GÉRANT */}
              {isAdmin && (
                <div className="flex items-center gap-1 border-l border-orange-500/30 pl-2 ml-1">
                  <NavLink href="/admin/technicians" isAdmin>👨‍🔧 Techniciens</NavLink>
                  <NavLink href="/admin/users" isAdmin>👥 Utilisateurs</NavLink>
                  <NavLink href="/admin/logs" isAdmin>📜 Logs</NavLink>
                </div>
              )}
            </div>

            {/* BOUTON TECHNICIENS + DÉCONNEXION - POUR TOUS LES COMPTES */}
<div className="hidden lg:flex items-center gap-4">
  
  {/* Bouton Techniciens - visible pour TOUS les comptes */}
  <Link href="/admin/technicians">
    <div className="relative group cursor-pointer">
      <div className="absolute -inset-1 rounded-full bg-gradient-to-r from-purple-500 to-purple-600 blur-md opacity-75 group-hover:opacity-100 transition duration-300"></div>
      <div className="relative flex items-center gap-2 px-4 py-1.5 bg-gradient-to-r from-purple-500 to-purple-600 rounded-full shadow-[0_0_15px_rgba(147,51,234,0.5)] group-hover:shadow-[0_0_25px_rgba(147,51,234,0.8)] transition-all duration-300">
        <span className="text-white text-sm">👨‍🔧</span>
        <span className="text-white text-xs font-bold tracking-wider">TECHNICIENS</span>
      </div>
    </div>
  </Link>
  
  {/* Bouton Déconnexion */}
  <button
    onClick={handleLogout}
    className="relative group/btn flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-red-600 to-red-700 text-white rounded-full text-sm font-semibold transition-all duration-300 shadow-[0_0_20px_rgba(239,68,68,0.4)] hover:shadow-[0_0_30px_rgba(239,68,68,0.7)] hover:scale-105 overflow-hidden"
  >
    <span className="absolute inset-0 bg-gradient-to-r from-red-500 to-red-600 opacity-0 group-hover/btn:opacity-100 transition-opacity duration-300"></span>
    <span className="relative z-10 flex items-center gap-2">
      <span className="text-lg">🚪</span>
      <span>Déconnexion</span>
    </span>
  </button>
</div>
            {/* Bouton menu mobile */}
            <button
              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
              className="lg:hidden p-2 rounded-lg hover:bg-white/10 transition"
            >
              <svg className="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                {mobileMenuOpen ? (
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                ) : (
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 6h16M4 12h16M4 18h16" />
                )}
              </svg>
            </button>
          </div>

          {/* MENU MOBILE - AVEC FILTRE PERMISSIONS */}
          {mobileMenuOpen && (
            <div className="lg:hidden py-4 border-t border-orange-500/20">
              <div className="flex flex-col space-y-2">
                {(!isTechnician || permissions.dashboard) && (
                  <MobileNavLink href="/dashboard" onClick={() => setMobileMenuOpen(false)}>📊 Dashboard</MobileNavLink>
                )}
                {(!isTechnician || permissions.repairs) && (
                  <MobileNavLink href="/repairs" onClick={() => setMobileMenuOpen(false)}>🔧 Réparations</MobileNavLink>
                )}
                {(!isTechnician || permissions.clients) && (
                  <MobileNavLink href="/clients" onClick={() => setMobileMenuOpen(false)}>👥 Clients</MobileNavLink>
                )}
                {(!isTechnician || permissions.historique) && (
                  <MobileNavLink href="/historique" onClick={() => setMobileMenuOpen(false)}>📜 Historique</MobileNavLink>
                )}
                {(!isTechnician || permissions.factures) && (
                  <MobileNavLink href="/factures" onClick={() => setMobileMenuOpen(false)}>💰 Factures</MobileNavLink>
                )}
                {(!isTechnician || permissions.paiements) && (
                  <MobileNavLink href="/paiements" onClick={() => setMobileMenuOpen(false)}>💳 Paiements</MobileNavLink>
                )}
                {(!isTechnician || permissions.client_submissions) && (
                  <MobileNavLink href="/admin/client-submissions" onClick={() => setMobileMenuOpen(false)}>
                    📱 Appareils saisis
                    {clientSubmissions > 0 && (
                      <span className="ml-1 bg-orange-500 text-white text-xs px-1.5 py-0.5 rounded-full">
                        {clientSubmissions}
                      </span>
                    )}
                  </MobileNavLink>
                )}
                {(!isTechnician || permissions.client_space) && (
                  <MobileNavLink href="/client" onClick={() => setMobileMenuOpen(false)}>🌍 Espace client</MobileNavLink>
                )}
                
                {(!isTechnician || permissions.settings) && (
                  <div className="pt-2">
                    <div className="px-3 py-2 text-xs font-semibold text-orange-400 uppercase">Gestion avancée</div>
                    {(!isTechnician || permissions.statistiques) && (
                      <MobileNavLink href="/statistiques" onClick={() => setMobileMenuOpen(false)}>📈 Statistiques</MobileNavLink>
                    )}
                    {(!isTechnician || permissions.stock) && (
                      <MobileNavLink href="/stock" onClick={() => setMobileMenuOpen(false)}>📦 Stock</MobileNavLink>
                    )}
                    {(!isTechnician || permissions.fournisseurs) && (
                      <MobileNavLink href="/fournisseurs" onClick={() => setMobileMenuOpen(false)}>🚚 Fournisseurs</MobileNavLink>
                    )}
                    <MobileNavLink href="/settings" onClick={() => setMobileMenuOpen(false)}>⚙️ Paramètres généraux</MobileNavLink>
                  </div>
                )}
                
                {/* ADMIN MENU MOBILE - UNIQUEMENT POUR GÉRANT */}
                {isAdmin && (
                  <div className="pt-2">
                    <div className="px-3 py-2 text-xs font-semibold text-orange-400 uppercase">Administration</div>
                    <MobileNavLink href="/admin/technicians" onClick={() => setMobileMenuOpen(false)}>👨‍🔧 Techniciens</MobileNavLink>
                    <MobileNavLink href="/admin/users" onClick={() => setMobileMenuOpen(false)}>👥 Utilisateurs</MobileNavLink>
                    <MobileNavLink href="/admin/logs" onClick={() => setMobileMenuOpen(false)}>📜 Logs</MobileNavLink>
                  </div>
                )}
                
                <div className="pt-4 border-t border-orange-500/20 mt-2">
                  <div className="flex items-center justify-between px-3 py-2">
                    <div className="flex items-center gap-2">
                      <div className="flex items-center gap-1 px-2 py-1 bg-gradient-to-r from-orange-500 to-orange-600 rounded-full">
                        <span className="text-white text-xs">
                          {isTechnician ? "👨‍🔧" : "👨‍💼"}
                        </span>
                        <span className="text-white text-[10px] font-bold">
                          {isTechnician ? "TECH" : "PRO"}
                        </span>
                      </div>
                    </div>
                  </div>
                  <button onClick={handleLogout} className="w-full flex items-center gap-3 px-4 py-2 rounded-lg text-red-400 hover:text-red-300 hover:bg-red-500/10 transition">
                    <span>🚪</span>
                    <span>Déconnexion</span>
                  </button>
                </div>
              </div>
            </div>
          )}
        </div>
      </nav>
      
      {/* MAIN CONTENT */}
      <main className="w-full mx-auto px-3 sm:px-4 md:px-6 py-6 animate-fade-in">
        {children}
      </main>

      {/* ========== EMAIL EN BAS ========== */}
      <footer className="border-t border-orange-500/30 py-4 bg-black/40">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-center items-center">
            <div className="flex items-center gap-3">
              <div className="w-2 h-2 bg-green-500 rounded-full animate-pulse shadow-[0_0_8px_rgba(34,197,94,0.8)]"></div>
              <span className="text-orange-400 text-sm font-mono font-medium drop-shadow-[0_0_8px_rgba(249,115,22,0.5)]">
                {isTechnician ? (technician?.name || userEmail) : userEmail}
              </span>
              {isTechnician && (
                <span className="text-xs text-orange-500/70">(Technicien)</span>
              )}
            </div>
          </div>
        </div>
      </footer>
    </div>
  );
}

// Composant NavLink
function NavLink({ href, children, isAdmin }) {
  return (
    <Link
      href={href}
      className={`relative px-3 py-1.5 rounded-full text-sm font-medium transition-all duration-300 group/item overflow-hidden ${
        isAdmin 
          ? "text-red-400 hover:text-red-300" 
          : "text-gray-300 hover:text-white"
      }`}
    >
      <span className="absolute inset-0 bg-gradient-to-r from-orange-600 to-orange-500 opacity-0 group-hover/item:opacity-100 transition-opacity duration-300 rounded-full shadow-[0_0_15px_rgba(249,115,22,0.5)]"></span>
      <span className="relative z-10 flex items-center gap-1.5">
        {children}
      </span>
    </Link>
  );
}

// Composant MobileNavLink
function MobileNavLink({ href, children, onClick }) {
  return (
    <Link
      href={href}
      onClick={onClick}
      className="flex items-center gap-3 px-4 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-orange-500/20 transition"
    >
      {children}
    </Link>
  );
}