"use client";

import { useEffect, useState, useRef, useCallback } from "react";
import { supabase, getCurrentUser } from "../../lib/supabase";
import { useRouter } from "next/navigation";
import Layout from "../../components/Layout";
import emailjs from '@emailjs/browser';
import ReturnModal from "../../components/ReturnModal";

export default function Dashboard() {
  const router = useRouter();
  const clientInputRef = useRef(null);
  const phoneInputRef = useRef(null);
  const emailInputRef = useRef(null);
  const repairRefs = useRef([]);

  const [loading, setLoading] = useState(false);
  const [message, setMessage] = useState({ text: "", type: "" });

  // SEARCH TICKETS
  const [searchQuery, setSearchQuery] = useState("");
  const [searchResults, setSearchResults] = useState([]);
  const [showResults, setShowResults] = useState(false);

  // MODAL DETAIL
  const [showDetailModal, setShowDetailModal] = useState(false);
  const [selectedRepairDetail, setSelectedRepairDetail] = useState(null);
  const [selectedRepairClient, setSelectedRepairClient] = useState(null);
  const [clientEmail, setClientEmail] = useState("");

  // RETOUR SAV
  const [showReturnModal, setShowReturnModal] = useState(false);
  const [selectedRepair, setSelectedRepair] = useState(null);

  // INFOS ATELIER
  const [companyInfo, setCompanyInfo] = useState({
    name: "MBX Réparations",
    phone: "",
    email: "",
    address: "",
    siret: ""
  });

  // FORMULAIRE CLIENT
  const [intakeClient, setIntakeClient] = useState("");
  const [intakePhone, setIntakePhone] = useState("");
  const [intakeEmail, setIntakeEmail] = useState("");
  const [selectedClientIndex, setSelectedClientIndex] = useState(-1);
  const [selectedPhoneIndex, setSelectedPhoneIndex] = useState(-1);

  // GESTION DU NOMBRE D'APPAREILS
  const [desiredRepairCount, setDesiredRepairCount] = useState(1);
  const [repairsList, setRepairsList] = useState([
    { device: "", issue: "", imei: "", code: "", estimatedPrice: "", notes: "", id: Date.now() }
  ]);

  // SUGGESTIONS clients existants
  const [clientSuggestions, setClientSuggestions] = useState([]);
  const [showClientSuggestions, setShowClientSuggestions] = useState(false);
  const [phoneSuggestions, setPhoneSuggestions] = useState([]);
  const [showPhoneSuggestions, setShowPhoneSuggestions] = useState(false);

  // MODÈLES, PANNES, CODES
  const defaultDevices = [
    "iPhone 16 Pro Max", "iPhone 16 Pro", "iPhone 16 Plus", "iPhone 16",
    "iPhone 15 Pro Max", "iPhone 15 Pro", "iPhone 15 Plus", "iPhone 15",
    "iPhone 14 Pro Max", "iPhone 14 Pro", "iPhone 14 Plus", "iPhone 14",
    "iPhone 13 Pro Max", "iPhone 13 Pro", "iPhone 13",
    "Galaxy S24 Ultra", "Galaxy S24 Plus", "Galaxy S24",
    "Galaxy S23 Ultra", "Galaxy S23 Plus", "Galaxy S23",
    "Xiaomi 14 Ultra", "Xiaomi 14 Pro", "Xiaomi 14",
    "Pixel 9 Pro", "Pixel 9", "OnePlus 12"
  ];

  const [customDevices, setCustomDevices] = useState([]);
  const allDevices = [...defaultDevices, ...customDevices];

  useEffect(() => {
    const savedDevices = localStorage.getItem("mbx_custom_devices");
    if (savedDevices) setCustomDevices(JSON.parse(savedDevices));
    const savedIssues = localStorage.getItem("mbx_custom_issues");
    if (savedIssues) setCustomIssues(JSON.parse(savedIssues));
    const savedCodes = localStorage.getItem("mbx_custom_codes");
    if (savedCodes) setCustomCodesList(JSON.parse(savedCodes));
  }, []);

  const saveCustomDevices = (newList) => {
    setCustomDevices(newList);
    localStorage.setItem("mbx_custom_devices", JSON.stringify(newList));
  };

  const defaultIssues = [
    "Écran cassé", "Batterie ne charge plus", "Microphone HS",
    "Appareil photo flou", "Plus de réseau", "Bootloop",
    "Bouton power HS", "Tombé dans l'eau", "Haut-parleur HS",
    "GPS ne fonctionne pas", "Oubli code", "WiFi ne marche pas"
  ];

  const [customIssues, setCustomIssues] = useState([]);
  const allIssues = [...defaultIssues, ...customIssues];

  const saveCustomIssues = (newList) => {
    setCustomIssues(newList);
    localStorage.setItem("mbx_custom_issues", JSON.stringify(newList));
  };

  const defaultCodesList = ["0000", "1234", "1111", "000000", "123456", "654321", "Code oublié", "Non fourni"];
  const [customCodesList, setCustomCodesList] = useState([]);
  const allCodesList = [...defaultCodesList, ...customCodesList];

  const saveCustomCodes = (newList) => {
    setCustomCodesList(newList);
    localStorage.setItem("mbx_custom_codes", JSON.stringify(newList));
  };

  const getCategoryFromDevice = (device) => {
    const lower = device.toLowerCase();
    if (lower.includes('iphone')) return '🍎 iPhone';
    if (lower.includes('galaxy') || lower.includes('samsung')) return '📱 Samsung';
    if (lower.includes('xiaomi')) return '📱 Xiaomi';
    if (lower.includes('pixel')) return '📱 Google Pixel';
    if (lower.includes('oneplus')) return '📱 OnePlus';
    return '📱 Autre';
  };

  const [deviceSuggestionsMap, setDeviceSuggestionsMap] = useState({});
  const [issueSuggestionsMap, setIssueSuggestionsMap] = useState({});
  const [codeSuggestionsMap, setCodeSuggestionsMap] = useState({});
  const [showDeviceSuggestionsMap, setShowDeviceSuggestionsMap] = useState({});
  const [showIssueSuggestionsMap, setShowIssueSuggestionsMap] = useState({});
  const [showCodeSuggestionsMap, setShowCodeSuggestionsMap] = useState({});
  const [deviceCategoryMap, setDeviceCategoryMap] = useState({});
  const [deviceSuggestionIndex, setDeviceSuggestionIndex] = useState({});
  const [issueSuggestionIndex, setIssueSuggestionIndex] = useState({});
  const [codeSuggestionIndex, setCodeSuggestionIndex] = useState({});

  const [recentTickets, setRecentTickets] = useState([]);
  const [showPrintToast, setShowPrintToast] = useState(false);
  const [showEmailToast, setShowEmailToast] = useState(false);
  const [emailTo, setEmailTo] = useState("");
  const [sendingEmail, setSendingEmail] = useState(false);

  const [newDeviceInput, setNewDeviceInput] = useState("");
  const [newIssueInput, setNewIssueInput] = useState("");
  const [newCodeInput, setNewCodeInput] = useState("");
  const [showAddDevice, setShowAddDevice] = useState(false);
  const [showAddIssue, setShowAddIssue] = useState(false);
  const [showAddCode, setShowAddCode] = useState(false);

  const EMAILJS_PUBLIC_KEY = "DezSbYxdfKhdK_HlF";
  const EMAILJS_SERVICE_ID = "service_1e02n3f";
  const EMAILJS_TEMPLATE_ID = "template_9q8ge09";

  // Charger les infos de l'atelier
  useEffect(() => {
    const loadCompanyInfo = async () => {
      const user = await getCurrentUser();
      if (user) {
        const { data: profile } = await supabase
          .from("profiles")
          .select("company_name, contact_phone, contact_address, email")
          .eq("id", user.id)
          .single();
        
        if (profile) {
          setCompanyInfo({
            name: profile.company_name || "MBX Réparations",
            phone: profile.contact_phone || "",
            email: profile.email || user.email,
            address: profile.contact_address || "",
            siret: profile.siret || ""
          });
        }
      }
    };
    loadCompanyInfo();
  }, []);

  useEffect(() => {
    if (clientInputRef.current) clientInputRef.current.focus();
  }, []);

  const showMessage = (text, type = "success") => {
    setMessage({ text, type });
    setTimeout(() => setMessage({ text: "", type: "" }), 3000);
  };

  // RECHERCHE TICKETS
  const searchTickets = async () => {
    if (!searchQuery.trim()) {
      setSearchResults([]);
      setShowResults(false);
      return;
    }
    const term = searchQuery.trim().toLowerCase();
    const user = await getCurrentUser();
    if (!user) return;
    
    const { data: allRepairs } = await supabase
      .from("repairs")
      .select("*")
      .eq("user_id", user.id)
      .order("id", { ascending: false });
    if (!allRepairs) return;
    
    const { data: allClients } = await supabase
      .from("clients")
      .select("id, name, phone, email")
      .eq("user_id", user.id);
    const clientMap = new Map();
    allClients?.forEach(c => clientMap.set(c.id, c));
    
    const filtered = allRepairs.filter(repair => {
      const ticketMatch = repair.id.toString().includes(term) || `mbx-${repair.id}`.includes(term);
      const client = clientMap.get(repair.client_id);
      const clientName = client?.name?.toLowerCase() || "";
      const clientMatch = clientName.includes(term);
      return ticketMatch || clientMatch;
    });
    const results = filtered.map(repair => ({
      ...repair,
      client: clientMap.get(repair.client_id) || { name: "Client inconnu", email: "" }
    }));
    setSearchResults(results);
    setShowResults(true);
  };

  useEffect(() => {
    const t = setTimeout(() => searchTickets(), 300);
    return () => clearTimeout(t);
  }, [searchQuery]);

  // RECHERCHE CLIENTS
  const searchClients = useCallback(async (term) => {
    if (!term.trim()) {
      setClientSuggestions([]);
      setShowClientSuggestions(false);
      setSelectedClientIndex(-1);
      return;
    }
    const user = await getCurrentUser();
    if (!user) return;
    
    const { data } = await supabase
      .from("clients")
      .select("id, name, phone, email")
      .eq("user_id", user.id)
      .or(`name.ilike.%${term}%, phone.ilike.%${term}%`)
      .limit(8);
    setClientSuggestions(data || []);
    setShowClientSuggestions(data && data.length > 0);
    setSelectedClientIndex(-1);
  }, []);

  const searchByPhone = useCallback(async (term) => {
    if (!term.trim()) {
      setPhoneSuggestions([]);
      setShowPhoneSuggestions(false);
      setSelectedPhoneIndex(-1);
      return;
    }
    const user = await getCurrentUser();
    if (!user) return;
    
    const { data } = await supabase
      .from("clients")
      .select("id, name, phone, email")
      .eq("user_id", user.id)
      .ilike("phone", `%${term}%`)
      .limit(5);
    setPhoneSuggestions(data || []);
    setShowPhoneSuggestions(data && data.length > 0);
    setSelectedPhoneIndex(-1);
  }, []);

  const handleClientKeyDown = (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      if (showClientSuggestions && selectedClientIndex >= 0 && clientSuggestions[selectedClientIndex]) {
        selectClient(clientSuggestions[selectedClientIndex]);
      }
      phoneInputRef.current?.focus();
      return;
    }
    if (!showClientSuggestions) return;
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setSelectedClientIndex(prev => Math.min(prev + 1, clientSuggestions.length - 1));
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setSelectedClientIndex(prev => Math.max(prev - 1, -1));
    }
  };

  const handlePhoneKeyDown = (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      if (showPhoneSuggestions && selectedPhoneIndex >= 0 && phoneSuggestions[selectedPhoneIndex]) {
        selectPhoneSuggestion(phoneSuggestions[selectedPhoneIndex]);
      }
      emailInputRef.current?.focus();
      return;
    }
    if (!showPhoneSuggestions) return;
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setSelectedPhoneIndex(prev => Math.min(prev + 1, phoneSuggestions.length - 1));
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setSelectedPhoneIndex(prev => Math.max(prev - 1, -1));
    }
  };

  const handleEmailKeyDown = (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      const numberInput = document.querySelector('input[type="number"]');
      if (numberInput) numberInput.focus();
    }
  };

  const handleClientSearch = (value) => {
    setIntakeClient(value);
    searchClients(value);
  };

  const handlePhoneSearch = (value) => {
    setIntakePhone(value);
    searchByPhone(value);
  };

  const selectClient = (client) => {
    setIntakeClient(client.name);
    setIntakePhone(client.phone || "");
    setIntakeEmail(client.email || "");
    setShowClientSuggestions(false);
    setShowPhoneSuggestions(false);
    setSelectedClientIndex(-1);
    phoneInputRef.current?.focus();
  };

  const selectPhoneSuggestion = (client) => {
    setIntakePhone(client.phone);
    setIntakeClient(client.name);
    setIntakeEmail(client.email || "");
    setShowPhoneSuggestions(false);
    setShowClientSuggestions(false);
    setSelectedPhoneIndex(-1);
  };

  const generateRepairSlots = () => {
    let count = Math.max(1, parseInt(desiredRepairCount) || 1);
    if (count > 20) {
      showMessage("Maximum 20 appareils par client", "error");
      count = 20;
      setDesiredRepairCount(20);
    }
    const newList = [];
    const now = Date.now();
    for (let i = 0; i < count; i++) {
      newList.push({ device: "", issue: "", imei: "", code: "", estimatedPrice: "", notes: "", id: now + i });
    }
    setRepairsList(newList);
    setDeviceSuggestionsMap({});
    setIssueSuggestionsMap({});
    setCodeSuggestionsMap({});
    setShowDeviceSuggestionsMap({});
    setShowIssueSuggestionsMap({});
    setShowCodeSuggestionsMap({});
    setDeviceCategoryMap({});
    setDeviceSuggestionIndex({});
    setIssueSuggestionIndex({});
    setCodeSuggestionIndex({});
    showMessage(`${count} emplacement(s) de réparation créé(s)`, "success");
  };

  const removeRepair = (id) => {
    if (repairsList.length === 1) {
      showMessage("Il doit y avoir au moins une réparation", "error");
      return;
    }
    setRepairsList(prev => prev.filter(r => r.id !== id));
    setDeviceSuggestionsMap(prev => { const newMap = { ...prev }; delete newMap[id]; return newMap; });
    setIssueSuggestionsMap(prev => { const newMap = { ...prev }; delete newMap[id]; return newMap; });
    setCodeSuggestionsMap(prev => { const newMap = { ...prev }; delete newMap[id]; return newMap; });
    setShowDeviceSuggestionsMap(prev => { const newMap = { ...prev }; delete newMap[id]; return newMap; });
    setShowIssueSuggestionsMap(prev => { const newMap = { ...prev }; delete newMap[id]; return newMap; });
    setShowCodeSuggestionsMap(prev => { const newMap = { ...prev }; delete newMap[id]; return newMap; });
    setDeviceCategoryMap(prev => { const newMap = { ...prev }; delete newMap[id]; return newMap; });
  };

  const updateRepairField = (id, field, value) => {
    setRepairsList(prev => prev.map(r => r.id === id ? { ...r, [field]: value } : r));
  };

  const getDeviceSuggestions = (input) => {
    if (!input.trim()) return [];
    const lower = input.toLowerCase();
    return allDevices.filter(d => d.toLowerCase().includes(lower)).slice(0, 8);
  };

  const handleDeviceKeyDown = (e, id, fieldIndex) => {
    const suggestions = deviceSuggestionsMap[id] || [];
    const currentIndex = deviceSuggestionIndex[id] || -1;
    if (e.key === "Enter") {
      e.preventDefault();
      if (showDeviceSuggestionsMap[id] && currentIndex >= 0 && suggestions[currentIndex]) {
        selectDevice(id, suggestions[currentIndex]);
      }
      const nextField = repairRefs.current[fieldIndex + 1];
      if (nextField) nextField.focus();
      return;
    }
    if (e.key === "ArrowDown") {
      e.preventDefault();
      if (suggestions.length > 0) {
        setDeviceSuggestionIndex(prev => ({ ...prev, [id]: Math.min(currentIndex + 1, suggestions.length - 1) }));
      }
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setDeviceSuggestionIndex(prev => ({ ...prev, [id]: Math.max(currentIndex - 1, -1) }));
    }
  };

  const handleDeviceSearch = (id, value) => {
    updateRepairField(id, "device", value);
    const category = getCategoryFromDevice(value);
    setDeviceCategoryMap(prev => ({ ...prev, [id]: category }));
    if (!value.trim()) {
      setDeviceSuggestionsMap(prev => ({ ...prev, [id]: [] }));
      setShowDeviceSuggestionsMap(prev => ({ ...prev, [id]: false }));
      setDeviceSuggestionIndex(prev => ({ ...prev, [id]: -1 }));
      return;
    }
    const filtered = getDeviceSuggestions(value);
    setDeviceSuggestionsMap(prev => ({ ...prev, [id]: filtered }));
    setShowDeviceSuggestionsMap(prev => ({ ...prev, [id]: filtered.length > 0 }));
    setDeviceSuggestionIndex(prev => ({ ...prev, [id]: -1 }));
  };

  const selectDevice = (id, device) => {
    updateRepairField(id, "device", device);
    const category = getCategoryFromDevice(device);
    setDeviceCategoryMap(prev => ({ ...prev, [id]: category }));
    setShowDeviceSuggestionsMap(prev => ({ ...prev, [id]: false }));
    setDeviceSuggestionIndex(prev => ({ ...prev, [id]: -1 }));
  };

  const getIssueSuggestions = (input) => {
    if (!input.trim()) return [];
    const lower = input.toLowerCase();
    return allIssues.filter(i => i.toLowerCase().includes(lower)).slice(0, 8);
  };

  const handleIssueKeyDown = (e, id, fieldIndex) => {
    const suggestions = issueSuggestionsMap[id] || [];
    const currentIndex = issueSuggestionIndex[id] || -1;
    if (e.key === "Enter") {
      e.preventDefault();
      if (showIssueSuggestionsMap[id] && currentIndex >= 0 && suggestions[currentIndex]) {
        selectIssue(id, suggestions[currentIndex]);
      }
      const nextField = repairRefs.current[fieldIndex + 1];
      if (nextField) nextField.focus();
      return;
    }
    if (e.key === "ArrowDown") {
      e.preventDefault();
      if (suggestions.length > 0) {
        setIssueSuggestionIndex(prev => ({ ...prev, [id]: Math.min(currentIndex + 1, suggestions.length - 1) }));
      }
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setIssueSuggestionIndex(prev => ({ ...prev, [id]: Math.max(currentIndex - 1, -1) }));
    }
  };

  const handleIssueSearch = (id, value) => {
    updateRepairField(id, "issue", value);
    if (!value.trim()) {
      setIssueSuggestionsMap(prev => ({ ...prev, [id]: [] }));
      setShowIssueSuggestionsMap(prev => ({ ...prev, [id]: false }));
      setIssueSuggestionIndex(prev => ({ ...prev, [id]: -1 }));
      return;
    }
    const filtered = getIssueSuggestions(value);
    setIssueSuggestionsMap(prev => ({ ...prev, [id]: filtered }));
    setShowIssueSuggestionsMap(prev => ({ ...prev, [id]: filtered.length > 0 }));
    setIssueSuggestionIndex(prev => ({ ...prev, [id]: -1 }));
  };

  const selectIssue = (id, issue) => {
    updateRepairField(id, "issue", issue);
    setShowIssueSuggestionsMap(prev => ({ ...prev, [id]: false }));
    setIssueSuggestionIndex(prev => ({ ...prev, [id]: -1 }));
  };

  const searchCodeSuggestions = (value, repairId) => {
    if (!value.trim()) {
      setCodeSuggestionsMap(prev => ({ ...prev, [repairId]: [] }));
      setShowCodeSuggestionsMap(prev => ({ ...prev, [repairId]: false }));
      setCodeSuggestionIndex(prev => ({ ...prev, [repairId]: -1 }));
      return;
    }
    const filtered = allCodesList.filter(code => 
      code.toLowerCase().includes(value.toLowerCase())
    ).slice(0, 8);
    setCodeSuggestionsMap(prev => ({ ...prev, [repairId]: filtered }));
    setShowCodeSuggestionsMap(prev => ({ ...prev, [repairId]: filtered.length > 0 }));
    setCodeSuggestionIndex(prev => ({ ...prev, [repairId]: -1 }));
  };

  const handleCodeKeyDown = (e, id, fieldIndex) => {
    const suggestions = codeSuggestionsMap[id] || [];
    const currentIndex = codeSuggestionIndex[id] || -1;
    if (e.key === "Enter") {
      e.preventDefault();
      if (showCodeSuggestionsMap[id] && currentIndex >= 0 && suggestions[currentIndex]) {
        selectCodeForRepair(id, suggestions[currentIndex]);
      }
      if (fieldIndex + 1 < repairRefs.current.length) {
        repairRefs.current[fieldIndex + 1]?.focus();
      } else {
        createIntake();
      }
      return;
    }
    if (e.key === "ArrowDown") {
      e.preventDefault();
      if (suggestions.length > 0) {
        setCodeSuggestionIndex(prev => ({ ...prev, [id]: Math.min(currentIndex + 1, suggestions.length - 1) }));
      }
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setCodeSuggestionIndex(prev => ({ ...prev, [id]: Math.max(currentIndex - 1, -1) }));
    }
  };

  const selectCodeForRepair = (repairId, code) => {
    updateRepairField(repairId, "code", code);
    setShowCodeSuggestionsMap(prev => ({ ...prev, [repairId]: false }));
    setCodeSuggestionIndex(prev => ({ ...prev, [repairId]: -1 }));
  };

  const addCustomDevice = () => {
    if (!newDeviceInput.trim()) return;
    const newDevice = newDeviceInput.trim();
    if (allDevices.includes(newDevice)) {
      showMessage("Ce modèle existe déjà", "error");
      return;
    }
    const newList = [...customDevices, newDevice];
    saveCustomDevices(newList);
    setNewDeviceInput("");
    setShowAddDevice(false);
    showMessage(`Modèle "${newDevice}" ajouté`, "success");
  };

  const addCustomIssue = () => {
    if (!newIssueInput.trim()) return;
    const newIssue = newIssueInput.trim();
    if (allIssues.includes(newIssue)) {
      showMessage("Cette panne existe déjà", "error");
      return;
    }
    const newList = [...customIssues, newIssue];
    saveCustomIssues(newList);
    setNewIssueInput("");
    setShowAddIssue(false);
    showMessage(`Panne "${newIssue}" ajoutée`, "success");
  };

  const addCustomCode = () => {
    if (!newCodeInput.trim()) return;
    const newCode = newCodeInput.trim();
    if (allCodesList.includes(newCode)) {
      showMessage("Ce code existe déjà", "error");
      return;
    }
    const newList = [...customCodesList, newCode];
    setCustomCodesList(newList);
    saveCustomCodes(newList);
    setNewCodeInput("");
    setShowAddCode(false);
    showMessage(`Code "${newCode}" ajouté`, "success");
  };

  // Sauvegarde reçu dans Supabase
  const saveReceiptToSupabase = async (tickets, client) => {
    const user = await getCurrentUser();
    if (!user) {
      showMessage("Utilisateur non authentifié", "error");
      return false;
    }
    
    try {
      const receiptData = {
        receipt_number: `REC-${Date.now()}-${Math.floor(Math.random() * 1000)}`,
        user_id: user.id,
        client_name: client.name,
        client_phone: client.phone,
        client_email: client.email,
        tickets: tickets.map(t => ({
          id: t.id,
          device: t.device,
          issue: t.issue,
          imei: t.imei || "NC",
          code: t.unlock_code || "NC",
          notes: t.description || "NC"
        }))
      };
      
      const { error } = await supabase.from("receipts").insert([receiptData]);
      if (error) throw error;
      showMessage("✅ Reçu sauvegardé définitivement", "success");
      return true;
    } catch (err) {
      console.error("Erreur sauvegarde reçu:", err);
      showMessage("❌ Erreur lors de la sauvegarde", "error");
      return false;
    }
  };

  const generateReceiptHTML = (tickets, client) => {
    const date = new Date().toLocaleString('fr-FR');
    const ticketListHtml = tickets.map((ticket, idx) => `
      <div style="border-bottom:1px solid #ddd; margin-bottom:16px; padding-bottom:12px;">
        <h3 style="margin:0 0 6px 0; font-size:16px;">Ticket n° MBX-${ticket.id}</h3>
        <p><strong>Appareil :</strong> ${ticket.device}</p>
        <p><strong>Panne :</strong> ${ticket.issue}</p>
        <p><strong>IMEI :</strong> ${ticket.imei || 'NC'}</p>
        <p><strong>Code :</strong> ${ticket.unlock_code || 'NC'}</p>
        <p><strong>Notes :</strong> ${ticket.description || 'Aucune'}</p>
      </div>
    `).join('');
    
    return `<!DOCTYPE html>
    <html>
    <head>
      <meta charset="UTF-8">
      <title>Reçu de dépôt - ${companyInfo.name}</title>
      <style>
        body { font-family: 'Courier New', monospace; margin: 20px; }
        .header { text-align: center; margin-bottom: 20px; border-bottom: 2px solid #333; padding-bottom: 10px; }
        .company-info { text-align: center; margin-bottom: 15px; font-size: 12px; color: #555; }
        .client-info { background: #f5f5f5; padding: 10px; margin-bottom: 20px; border-radius: 8px; }
        .footer { text-align: center; margin-top: 30px; font-size: 11px; color: #666; border-top: 1px solid #ccc; padding-top: 10px; }
        @media print { body { margin: 0; padding: 10px; } .no-print { display: none; } }
        button { margin-top: 20px; padding: 10px 20px; background: #333; color: white; border: none; border-radius: 5px; cursor: pointer; }
      </style>
    </head>
    <body>
      <div class="header">
        <h2>🔧 ${companyInfo.name}</h2>
        <div class="company-info">
          ${companyInfo.address ? `<div>📍 ${companyInfo.address}</div>` : ''}
          ${companyInfo.phone ? `<div>📞 ${companyInfo.phone}</div>` : ''}
          ${companyInfo.email ? `<div>✉️ ${companyInfo.email}</div>` : ''}
          ${companyInfo.siret ? `<div>🧾 SIRET: ${companyInfo.siret}</div>` : ''}
        </div>
        <p>Reçu de dépôt<br>${date}</p>
      </div>
      <div class="client-info">
        <strong>👤 Client :</strong> ${client.name}<br>
        <strong>📞 Téléphone :</strong> ${client.phone}<br>
        <strong>✉️ Email :</strong> ${client.email}
      </div>
      <div>
        <strong>📦 Appareil(s) déposé(s) :</strong>
        ${ticketListHtml}
      </div>
      <div class="footer">
        Merci de votre confiance — Suivi sur notre espace client.<br>
        🔧 ${companyInfo.name}
      </div>
      <div class="no-print" style="text-align:center;">
        <button onclick="window.print();">🖨️ Imprimer</button>
        <button onclick="window.close();" style="margin-left:10px;">Fermer</button>
      </div>
    </body>
    </html>`;
  };

  const printTickets = async (tickets, client) => {
    await saveReceiptToSupabase(tickets, client);
    const html = generateReceiptHTML(tickets, client);
    const printWindow = window.open('', '_blank');
    printWindow.document.write(html);
    printWindow.document.close();
    setShowPrintToast(false);
  };

  // Envoi d'email avec lien de suivi
  const sendEmailReceipt = async (tickets, client, recipientEmail, trackingUrl = null) => {
    if (!recipientEmail || !recipientEmail.trim()) {
      showMessage("Adresse email requise", "error");
      return false;
    }
    setSendingEmail(true);
    try {
      const repairsHtml = tickets.map(t => `
        <div style="border-bottom:1px solid #ccc; margin-bottom:10px; padding-bottom:8px;">
          <strong>🔧 Ticket MBX-${t.id}</strong><br/>
          📱 Appareil : ${escapeHtml(t.device)}<br/>
          ⚠️ Panne : ${escapeHtml(t.issue)}<br/>
          🔢 IMEI : ${escapeHtml(t.imei || 'NC')}<br/>
          🔑 Code : ${escapeHtml(t.unlock_code || 'NC')}<br/>
          📝 Notes : ${escapeHtml(t.description || 'Aucune')}
        </div>
      `).join('');

      const trackingHtml = trackingUrl ? `
        <div style="background: #e8f4fd; border-radius: 8px; padding: 15px; margin: 20px 0; text-align: center;">
          <p style="margin: 0 0 10px 0; color: #0066cc; font-weight: bold;">🔗 Suivez l'avancement de votre réparation</p>
          <a href="${trackingUrl}" style="background: #2563eb; color: white; padding: 10px 20px; text-decoration: none; border-radius: 8px; display: inline-block;">📱 Cliquez ici pour suivre</a>
          <p style="font-size: 12px; color: #666; margin-top: 10px;">Lien valable 30 jours</p>
        </div>
      ` : '';

      const templateParams = {
        company_name: companyInfo.name,
        company_address: companyInfo.address,
        company_phone: companyInfo.phone,
        company_email: companyInfo.email,
        company_siret: companyInfo.siret,
        client_name: client.name,
        client_phone: client.phone,
        client_email: client.email,
        date: new Date().toLocaleString('fr-FR'),
        repairs_html: repairsHtml,
        tracking_html: trackingHtml,
        tracking_url: trackingUrl || '',
        to_email: recipientEmail.trim()
      };

      await emailjs.send(
        EMAILJS_SERVICE_ID,
        EMAILJS_TEMPLATE_ID,
        templateParams,
        EMAILJS_PUBLIC_KEY
      );
      showMessage(`✅ Email envoyé à ${recipientEmail}`, "success");
      setShowEmailToast(false);
      return true;
    } catch (err) {
      console.error("Erreur EmailJS:", err);
      showMessage(`❌ Échec envoi email: ${err.text || err.message}`, "error");
      return false;
    } finally {
      setSendingEmail(false);
    }
  };

  const escapeHtml = (str) => {
    if (!str) return '';
    return str.replace(/[&<>]/g, function(m) {
      if (m === '&') return '&amp;';
      if (m === '<') return '&lt;';
      if (m === '>') return '&gt;';
      return m;
    });
  };

  // GÉNÉRER LIEN DE SUIVI - Version avec API
  const genererLienSuivi = async (repair, client) => {
    try {
      showMessage("⏳ Génération du lien de suivi...", "info");
      
      const baseUrl = process.env.NEXT_PUBLIC_APP_URL || window.location.origin;
      
      const response = await fetch('/api/generate-tracking-link', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          repairId: repair.id,
          clientName: client.name,
          clientPhone: client.phone,
          clientEmail: client.email,
          baseUrl: baseUrl
        })
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || `Erreur HTTP ${response.status}`);
      }

      if (data.success) {
        await navigator.clipboard.writeText(data.url);
        alert(`✅ LIEN DE SUIVI GÉNÉRÉ AVEC SUCCÈS !\n\n🔗 ${data.url}\n\n📋 Lien copié dans le presse-papier\n⏰ Valable 30 jours`);
        showMessage("✅ Lien de suivi généré et copié !", "success");
        return data.url;
      } else {
        showMessage("❌ Erreur: " + data.error, "error");
        return null;
      }
    } catch (error) {
      console.error("❌ Erreur génération lien:", error);
      showMessage("❌ " + error.message, "error");
      return null;
    }
  };

  const showTicketDetails = (ticket) => {
    setSelectedRepairDetail(ticket);
    setSelectedRepairClient(ticket.client);
    setClientEmail(ticket.client?.email || "");
    setShowDetailModal(true);
    setSearchQuery("");
    setShowResults(false);
  };

  const createIntake = async () => {
    const user = await getCurrentUser();
    if (!user) {
      showMessage("Utilisateur non authentifié", "error");
      return;
    }

    if (!intakeClient.trim()) {
      showMessage("Le nom du client est requis", "error");
      clientInputRef.current?.focus();
      return;
    }
    const hasEmptyRepair = repairsList.some(r => !r.device.trim() || !r.issue.trim());
    if (hasEmptyRepair) {
      showMessage("Chaque réparation doit avoir un appareil et une panne", "error");
      return;
    }
    setLoading(true);
    try {
      let { data: existing, error: searchError } = await supabase
        .from("clients")
        .select("*")
        .eq("user_id", user.id)
        .ilike("name", intakeClient)
        .maybeSingle();

      if (searchError) throw new Error("Erreur recherche client: " + searchError.message);

      let clientId;
      let clientData;
      if (!existing) {
        const { data: newClient, error: insertError } = await supabase
          .from("clients")
          .insert([{ 
            name: intakeClient, 
            phone: intakePhone || "NC", 
            email: intakeEmail || "NC",
            user_id: user.id
          }])
          .select()
          .single();
        
        if (insertError) throw insertError;
        clientId = newClient.id;
        clientData = newClient;
      } else {
        clientId = existing.id;
        clientData = existing;
        if ((intakePhone && existing.phone !== intakePhone) || (intakeEmail && existing.email !== intakeEmail)) {
          await supabase
            .from("clients")
            .update({ 
              phone: intakePhone || existing.phone, 
              email: intakeEmail || existing.email
            })
            .eq("id", existing.id);
          clientData = { ...existing, 
            phone: intakePhone || existing.phone, 
            email: intakeEmail || existing.email
          };
        }
      }
      
      const createdRepairs = [];
      for (const repair of repairsList) {
        const { data: newRepair, error: repairError } = await supabase
          .from("repairs")
          .insert([{
            client_id: clientId,
            device: repair.device,
            issue: repair.issue,
            imei: repair.imei || "NC",
            unlock_code: repair.code || "NC",
            description: repair.notes || "NC",
            estimated_price: parseFloat(repair.estimatedPrice) || 0,
            final_price: 0,
            status: "🟡 Réceptionné",
            user_id: user.id
          }])
          .select()
          .single();
        
        if (repairError) throw repairError;
        createdRepairs.push(newRepair);
      }
      if (createdRepairs.length > 0 && clientData) {
        await saveReceiptToSupabase(createdRepairs, clientData);
      }

      showMessage(`✅ ${createdRepairs.length} ticket(s) créé(s)`, "success");
      setRecentTickets(createdRepairs);
      setShowPrintToast(true);
      setShowEmailToast(true);
      setEmailTo(clientData.email || "");
      
      setIntakeClient("");
      setIntakePhone("");
      setIntakeEmail("");
      setDesiredRepairCount(1);
      setRepairsList([{ device: "", issue: "", imei: "", code: "", estimatedPrice: "", notes: "", id: Date.now() }]);
      setClientSuggestions([]);
      setPhoneSuggestions([]);
      setShowClientSuggestions(false);
      setShowPhoneSuggestions(false);
      setDeviceSuggestionsMap({});
      setIssueSuggestionsMap({});
      setCodeSuggestionsMap({});
      setShowDeviceSuggestionsMap({});
      setShowIssueSuggestionsMap({});
      setShowCodeSuggestionsMap({});
      setDeviceCategoryMap({});
      clientInputRef.current?.focus();
      
    } catch (err) {
      console.error("❌ Erreur création:", err);
      showMessage("❌ Erreur: " + (err.message || "Erreur inconnue"), "error");
    } finally {
      setLoading(false);
    }
  };

  const formatDate = (date) => {
    if (!date) return "-";
    return new Date(date).toLocaleDateString("fr-FR", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit"
    });
  };

  const handleNumberKeyDown = (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      const firstRepair = repairRefs.current[0];
      if (firstRepair) firstRepair.focus();
    }
  };

  return (
    <Layout>
      {message.text && (
        <div className={`fixed bottom-5 right-5 px-5 py-3 rounded-xl shadow-lg z-50 text-white ${message.type === "error" ? "bg-red-500" : "bg-green-500"}`}>
          {message.text}
        </div>
      )}

      {/* MODAL RETOUR SAV */}
      {showReturnModal && selectedRepair && (
        <ReturnModal
          repair={selectedRepair}
          onClose={() => setShowReturnModal(false)}
          onSuccess={() => {
            setShowReturnModal(false);
            setSelectedRepair(null);
            searchTickets();
          }}
        />
      )}

      {(showPrintToast || showEmailToast) && recentTickets.length > 0 && (
        <div className="fixed bottom-5 left-1/2 transform -translate-x-1/2 bg-white rounded-xl shadow-2xl border p-4 z-50 flex gap-4 min-w-[400px]">
          <div className="flex-1">
            <div className="font-semibold text-gray-800 mb-2">📋 Tickets créés !</div>
            <div className="flex gap-3">
              <button
                onClick={async () => {
                  const clientId = recentTickets[0]?.client_id;
                  if (clientId) {
                    const { data } = await supabase
                      .from("clients")
                      .select("*")
                      .eq("id", clientId)
                      .single();
                    if (data) printTickets(recentTickets, data);
                  }
                }}
                className="flex-1 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-blue-700"
              >
                🖨️ Imprimer
              </button>
              <button
                onClick={() => setShowEmailToast(true)}
                className="flex-1 bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-700"
              >
                ✉️ Envoyer par email
              </button>
              <button
                onClick={() => {
                  setShowPrintToast(false);
                  setShowEmailToast(false);
                }}
                className="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg text-sm hover:bg-gray-300"
              >
                ✕
              </button>
            </div>
          </div>
        </div>
      )}

      {showEmailToast && recentTickets.length > 0 && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-xl p-6 max-w-md w-full">
            <h3 className="text-xl font-bold mb-4">✉️ Envoi par email</h3>
            <div className="mb-4">
              <label className="block text-sm font-medium text-gray-700 mb-1">
                📧 Email du client
              </label>
              <input
                type="email"
                className="border p-3 rounded-lg w-full bg-blue-50 border-blue-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                value={emailTo}
                onChange={(e) => setEmailTo(e.target.value)}
                placeholder="Email du client"
                onKeyDown={(e) => e.key === "Enter" && e.preventDefault()}
                autoFocus
              />
              <p className="text-xs text-green-600 mt-1">
                ✅ L'email du client a été automatiquement renseigné
              </p>
            </div>
            <div className="mb-4 p-3 bg-gray-50 rounded-lg">
              <p className="text-sm font-medium text-gray-700 mb-2">
                📋 Tickets à envoyer :
              </p>
              {recentTickets.map((ticket) => (
                <div key={ticket.id} className="text-xs text-gray-600">
                  • MBX-{ticket.id} - {ticket.device}
                </div>
              ))}
            </div>
            <div className="flex gap-2">
              <button
                onClick={async () => {
                  const clientId = recentTickets[0]?.client_id;
                  if (clientId) {
                    const { data } = await supabase
                      .from("clients")
                      .select("*")
                      .eq("id", clientId)
                      .single();
                    if (data) {
                      const trackingUrl = await genererLienSuivi(recentTickets[0], data);
                      const sent = await sendEmailReceipt(recentTickets, data, emailTo, trackingUrl);
                      if (sent) {
                        setShowEmailToast(false);
                        setEmailTo("");
                      }
                    }
                  }
                }}
                disabled={sendingEmail || !emailTo.trim()}
                className="flex-1 bg-green-600 text-white py-2 rounded-lg disabled:bg-gray-400 hover:bg-green-700 transition"
              >
                {sendingEmail ? "📧 Envoi en cours..." : "✉️ Envoyer"}
              </button>
              <button
                onClick={() => {
                  setShowEmailToast(false);
                  setEmailTo("");
                }}
                className="flex-1 bg-gray-200 py-2 rounded-lg hover:bg-gray-300 transition"
              >
                Annuler
              </button>
            </div>
          </div>
        </div>
      )}

      {/* HEADER */}
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <h1 className="text-2xl font-bold">📊 Dashboard</h1>
        <div className="relative w-full sm:w-80">
          <input className="w-full p-2.5 pl-10 bg-gray-100 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-gray-400 text-sm" placeholder="🔍 Rechercher par ticket (MBX-18) ou nom client..." value={searchQuery} onChange={(e) => setSearchQuery(e.target.value)} />
          <div className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">🔍</div>
          {searchQuery && <button onClick={() => setSearchQuery("")} className="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">✕</button>}
        </div>
      </div>

      {/* RÉSULTATS RECHERCHE */}
      {showResults && searchResults.length > 0 && (
        <div className="bg-white rounded-xl shadow-xl border mb-6 overflow-hidden">
          <div className="p-2 bg-gray-50 border-b text-xs text-gray-500 font-medium flex justify-between items-center">
            <span>{searchResults.length} résultat(s) trouvé(s)</span>
          </div>
          {searchResults.map((r) => (
            <div key={r.id} className="p-3 border-b hover:bg-gray-50 cursor-pointer transition">
              <div className="flex justify-between items-center">
                <div onClick={() => showTicketDetails(r)} className="flex-1">
                  <div className="flex items-center gap-2 flex-wrap">
                    <span className="font-mono font-bold text-gray-800">MBX-{r.id}</span>
                    <span className={`text-xs px-2 py-0.5 rounded-full ${
                      r.status === "✅ Terminé" ? "bg-green-100 text-green-800" :
                      r.status === "🔧 En réparation" ? "bg-blue-100 text-blue-800" :
                      r.status === "📦 Rendu" ? "bg-gray-800 text-white" :
                      "bg-yellow-100 text-yellow-800"
                    }`}>
                      {r.status || "🟡 Réceptionné"}
                    </span>
                  </div>
                  <div className="text-sm text-gray-600">{r.client?.name || "Client inconnu"}</div>
                  <div className="text-xs text-gray-500 mt-0.5">📱 {r.device} • 🔧 {r.issue}</div>
                </div>
                <div className="flex items-center gap-2">
                  {/* RETOUR SAV */}
                  {(r.status === "✅ Terminé" || r.status === "📦 Rendu") && (
                    <button
                      onClick={(e) => {
                        e.stopPropagation();
                        setSelectedRepair(r);
                        setShowReturnModal(true);
                      }}
                      className="px-2 py-1 bg-amber-500 text-white rounded-lg text-xs hover:bg-amber-600 transition"
                      title="Retour SAV"
                    >
                      🔄 Retour SAV
                    </button>
                  )}
                  {/* BOUTON LIEN DE SUIVI */}
                  <button
                    onClick={async (e) => {
                      e.stopPropagation();
                      const { data: clientData } = await supabase
                        .from("clients")
                        .select("*")
                        .eq("id", r.client_id)
                        .single();
                      if (clientData) {
                        await genererLienSuivi(r, clientData);
                      } else {
                        showMessage("Client non trouvé", "error");
                      }
                    }}
                    className="px-2 py-1 bg-purple-500 text-white rounded-lg text-xs hover:bg-purple-600 transition"
                    title="Générer lien de suivi"
                  >
                    🔗 Lien
                  </button>
                  {/* EMAIL */}
                  <button
                    onClick={async (e) => {
                      e.stopPropagation();
                      const { data: clientData } = await supabase
                        .from("clients")
                        .select("*")
                        .eq("id", r.client_id)
                        .single();
                      if (clientData) {
                        const trackingUrl = await genererLienSuivi(r, clientData);
                        if (clientData.email && clientData.email !== "NC") {
                          await sendEmailReceipt([r], clientData, clientData.email, trackingUrl);
                        } else {
                          setEmailTo("");
                          setRecentTickets([r]);
                          setShowEmailToast(true);
                        }
                      } else {
                        showMessage("Client non trouvé", "error");
                      }
                    }}
                    className="px-2 py-1 bg-green-500 text-white rounded-lg text-xs hover:bg-green-600 transition"
                    title="Envoyer par email avec lien de suivi"
                  >
                    ✉️ Email
                  </button>
                  {/* REÇU */}
                  <button
                    onClick={async (e) => {
                      e.stopPropagation();
                      const { data: clientData } = await supabase
                        .from("clients")
                        .select("*")
                        .eq("id", r.client_id)
                        .single();
                      if (clientData) {
                        printTickets([r], clientData);
                      } else {
                        showMessage("Client non trouvé", "error");
                      }
                    }}
                    className="px-2 py-1 bg-blue-500 text-white rounded-lg text-xs hover:bg-blue-600 transition"
                    title="Imprimer reçu de dépôt"
                  >
                    🖨️ Reçu
                  </button>
                  <div className="text-blue-500 text-sm ml-2">→</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
      {showResults && searchResults.length === 0 && searchQuery && <div className="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-center text-yellow-700 mb-6">Aucun ticket trouvé pour "{searchQuery}"</div>}

      {/* FORMULAIRE */}
      <div className="bg-white rounded-2xl shadow-lg border p-6">
        <h2 className="text-lg font-semibold mb-4">➕ Nouvelle réparation (multi‑appareils)</h2>
        <div className="space-y-5">
          <div className="bg-gray-50 p-4 rounded-xl">
            <h3 className="font-medium mb-3 text-gray-700">👤 Client</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
              <div className="relative">
                <input 
                  ref={clientInputRef}
                  className="border p-3 rounded-xl w-full" 
                  placeholder="Nom du client *" 
                  value={intakeClient} 
                  onChange={(e) => handleClientSearch(e.target.value)} 
                  onFocus={() => intakeClient && handleClientSearch(intakeClient)} 
                  onKeyDown={handleClientKeyDown}
                  autoComplete="off"
                />
                {showClientSuggestions && clientSuggestions.length > 0 && (
                  <div className="absolute z-10 bg-white border rounded-xl shadow-lg max-h-48 overflow-auto w-full mt-1">
                    {clientSuggestions.map((c, idx) => (
                      <div 
                        key={c.id} 
                        className={`p-2 cursor-pointer border-b last:border-0 ${selectedClientIndex === idx ? 'bg-blue-100' : 'hover:bg-gray-100'}`}
                        onMouseDown={() => selectClient(c)}
                      >
                        <div className="font-medium">{c.name}</div>
                        <div className="text-xs text-gray-500">{c.phone !== "NC" ? c.phone : ""} {c.email !== "NC" ? `• ${c.email}` : ""}</div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
              <div className="relative">
                <input 
                  ref={phoneInputRef}
                  className="border p-3 rounded-xl w-full" 
                  placeholder="Téléphone" 
                  value={intakePhone} 
                  onChange={(e) => handlePhoneSearch(e.target.value)} 
                  onFocus={() => intakePhone && handlePhoneSearch(intakePhone)} 
                  onKeyDown={handlePhoneKeyDown}
                  autoComplete="off"
                />
                {showPhoneSuggestions && phoneSuggestions.length > 0 && (
                  <div className="absolute z-10 bg-white border rounded-xl shadow-lg max-h-48 overflow-auto w-full mt-1">
                    {phoneSuggestions.map((c, idx) => (
                      <div 
                        key={c.id} 
                        className={`p-2 cursor-pointer border-b last:border-0 ${selectedPhoneIndex === idx ? 'bg-blue-100' : 'hover:bg-gray-100'}`}
                        onMouseDown={() => selectPhoneSuggestion(c)}
                      >
                        <div className="font-medium">{c.phone}</div>
                        <div className="text-xs text-gray-500">{c.name}</div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
              <input 
                ref={emailInputRef}
                className="border p-3 rounded-xl md:col-span-2" 
                placeholder="Email" 
                value={intakeEmail} 
                onChange={(e) => setIntakeEmail(e.target.value)}
                onKeyDown={handleEmailKeyDown}
              />
            </div>
          </div>

          <div className="bg-gray-50 p-4 rounded-xl">
            <div className="flex flex-wrap items-end justify-between gap-3 mb-4">
              <div className="flex gap-2 items-end">
                <div><label className="block text-xs text-gray-500 mb-1">Nombre d'appareils</label><input type="number" min="1" max="20" value={desiredRepairCount} onChange={(e) => setDesiredRepairCount(e.target.value)} className="border p-2 rounded-lg w-24 text-center" onKeyDown={handleNumberKeyDown} /></div>
                <button type="button" onClick={generateRepairSlots} className="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 text-sm">Générer</button>
              </div>
              <span className="text-xs text-gray-400">{repairsList.length} appareil(s)</span>
            </div>

            <div className="space-y-4">
              {repairsList.map((repair, idx) => {
                const deviceFieldIndex = idx * 3;
                const issueFieldIndex = idx * 3 + 1;
                const priceFieldIndex = idx * 3 + 2;
                const imeiFieldIndex = idx * 3 + 3;
                const codeFieldIndex = idx * 3 + 4;
                return (
                  <div key={repair.id} className="border border-gray-200 rounded-xl p-3 bg-white relative">
                    <div className="flex justify-between items-start mb-2">
                      <span className="text-xs font-semibold text-gray-500">Appareil #{idx+1}</span>
                      {repairsList.length > 1 && <button onClick={() => removeRepair(repair.id)} className="text-red-500 text-xs hover:text-red-700">🗑 Supprimer</button>}
                    </div>
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                      <div className="relative">
                        <div className="flex">
                          <input 
                            ref={el => repairRefs.current[deviceFieldIndex] = el}
                            className="border p-2 rounded-lg w-full" 
                            placeholder="📱 Modèle / Appareil *" 
                            value={repair.device} 
                            onChange={(e) => handleDeviceSearch(repair.id, e.target.value)} 
                            onFocus={() => repair.device && handleDeviceSearch(repair.id, repair.device)}
                            onKeyDown={(e) => handleDeviceKeyDown(e, repair.id, deviceFieldIndex)}
                          />
                          <button onClick={() => setShowAddDevice(true)} className="ml-1 px-2 bg-gray-200 rounded-lg text-gray-600 hover:bg-gray-300">➕</button>
                        </div>
                        {deviceCategoryMap[repair.id] && <div className="absolute right-10 top-1/2 -translate-y-1/2 text-xs bg-gray-200 px-2 py-0.5 rounded-full">{deviceCategoryMap[repair.id]}</div>}
                        {showDeviceSuggestionsMap[repair.id] && deviceSuggestionsMap[repair.id]?.length > 0 && (
                          <div className="absolute z-10 bg-white border rounded-lg shadow-lg max-h-36 overflow-auto w-full mt-1">
                            {deviceSuggestionsMap[repair.id].map((d, i) => (
                              <div key={i} className={`p-1.5 cursor-pointer text-sm ${deviceSuggestionIndex[repair.id] === i ? 'bg-blue-100' : 'hover:bg-gray-100'}`} onMouseDown={() => selectDevice(repair.id, d)}>
                                📱 {d}
                              </div>
                            ))}
                          </div>
                        )}
                      </div>

                      <div className="relative">
                        <div className="flex">
                          <input 
                            ref={el => repairRefs.current[issueFieldIndex] = el}
                            className="border p-2 rounded-lg w-full" 
                            placeholder="🔧 Panne / Problème *" 
                            value={repair.issue} 
                            onChange={(e) => handleIssueSearch(repair.id, e.target.value)} 
                            onFocus={() => repair.issue && handleIssueSearch(repair.id, repair.issue)}
                            onKeyDown={(e) => handleIssueKeyDown(e, repair.id, issueFieldIndex)}
                          />
                          <button onClick={() => setShowAddIssue(true)} className="ml-1 px-2 bg-gray-200 rounded-lg text-gray-600 hover:bg-gray-300">➕</button>
                        </div>
                        {showIssueSuggestionsMap[repair.id] && issueSuggestionsMap[repair.id]?.length > 0 && (
                          <div className="absolute z-10 bg-white border rounded-lg shadow-lg max-h-36 overflow-auto w-full mt-1">
                            {issueSuggestionsMap[repair.id].map((iss, i) => (
                              <div key={i} className={`p-1.5 cursor-pointer text-sm ${issueSuggestionIndex[repair.id] === i ? 'bg-blue-100' : 'hover:bg-gray-100'}`} onMouseDown={() => selectIssue(repair.id, iss)}>
                                🔧 {iss}
                              </div>
                            ))}
                          </div>
                        )}
                      </div>

                      <input 
                        ref={el => repairRefs.current[priceFieldIndex] = el}
                        className="border p-2 rounded-lg" 
                        placeholder="💰 Prix estimé (€)" 
                        type="number" 
                        value={repair.estimatedPrice} 
                        onChange={(e) => updateRepairField(repair.id, "estimatedPrice", e.target.value)}
                        onKeyDown={(e) => {
                          if (e.key === "Enter") {
                            e.preventDefault();
                            repairRefs.current[imeiFieldIndex]?.focus();
                          }
                        }}
                      />

                      <div className="flex gap-2">
                        <input 
                          ref={el => repairRefs.current[imeiFieldIndex] = el}
                          className="border p-2 rounded-lg flex-1" 
                          placeholder="🔢 IMEI" 
                          value={repair.imei} 
                          onChange={(e) => updateRepairField(repair.id, "imei", e.target.value)} 
                          maxLength="15"
                          onKeyDown={(e) => {
                            if (e.key === "Enter") {
                              e.preventDefault();
                              repairRefs.current[codeFieldIndex]?.focus();
                            }
                          }}
                        />
                        <div className="relative flex-1">
                          <input 
                            ref={el => repairRefs.current[codeFieldIndex] = el}
                            className="border p-2 rounded-lg w-full" 
                            placeholder="🔑 Code téléphone" 
                            value={repair.code} 
                            onChange={(e) => {
                              updateRepairField(repair.id, "code", e.target.value);
                              searchCodeSuggestions(e.target.value, repair.id);
                            }}
                            onFocus={() => repair.code && searchCodeSuggestions(repair.code, repair.id)}
                            onKeyDown={(e) => handleCodeKeyDown(e, repair.id, codeFieldIndex)}
                          />
                          {showCodeSuggestionsMap[repair.id] && codeSuggestionsMap[repair.id]?.length > 0 && (
                            <div className="absolute z-10 bg-white border rounded-lg shadow-lg max-h-36 overflow-auto w-full mt-1">
                              {codeSuggestionsMap[repair.id].map((code, i) => (
                                <div key={i} className={`p-1.5 cursor-pointer text-sm ${codeSuggestionIndex[repair.id] === i ? 'bg-blue-100' : 'hover:bg-gray-100'}`} onMouseDown={() => selectCodeForRepair(repair.id, code)}>
                                  🔑 {code}
                                </div>
                              ))}
                            </div>
                          )}
                        </div>
                      </div>
                    </div>
                    <textarea 
                      className="border p-2 rounded-lg w-full mt-2 resize-none text-sm" 
                      rows="1" 
                      placeholder="📝 Notes spécifiques (optionnel)" 
                      value={repair.notes} 
                      onChange={(e) => updateRepairField(repair.id, "notes", e.target.value)}
                      onKeyDown={(e) => {
                        if (e.key === "Enter") {
                          e.preventDefault();
                          if (idx === repairsList.length - 1) {
                            createIntake();
                          } else {
                            const nextDeviceIndex = (idx + 1) * 3;
                            repairRefs.current[nextDeviceIndex]?.focus();
                          }
                        }
                      }}
                    />
                  </div>
                );
              })}
            </div>
          </div>

          <button onClick={createIntake} disabled={loading} className="w-full bg-gray-900 text-white py-3 rounded-xl font-medium hover:bg-gray-800 transition disabled:opacity-50">{loading ? "⏳ Création..." : `📦 Créer ${repairsList.length} ticket(s)`}</button>
          <p className="text-center text-xs text-gray-400 pt-2">⌨️ Utilisez les flèches ↑↓ pour naviguer dans les suggestions et <kbd className="px-2 py-0.5 bg-gray-100 rounded-md font-mono">Entrée</kbd> pour sélectionner et passer au champ suivant</p>
        </div>
      </div>

      {/* MODALS AJOUT */}
      {showAddDevice && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
          <div className="bg-white rounded-xl p-6 w-96">
            <h3 className="text-lg font-bold mb-4">➕ Ajouter un modèle</h3>
            <input type="text" className="border p-2 rounded w-full mb-4" placeholder="Nom du modèle" value={newDeviceInput} onChange={(e) => setNewDeviceInput(e.target.value)} onKeyDown={(e) => e.key === "Enter" && addCustomDevice()} />
            <div className="flex gap-2">
              <button onClick={addCustomDevice} className="bg-green-600 text-white px-4 py-2 rounded flex-1">Ajouter</button>
              <button onClick={() => { setShowAddDevice(false); setNewDeviceInput(""); }} className="bg-gray-300 px-4 py-2 rounded flex-1">Annuler</button>
            </div>
          </div>
        </div>
      )}

      {showAddIssue && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
          <div className="bg-white rounded-xl p-6 w-96">
            <h3 className="text-lg font-bold mb-4">➕ Ajouter une panne</h3>
            <input type="text" className="border p-2 rounded w-full mb-4" placeholder="Nom de la panne" value={newIssueInput} onChange={(e) => setNewIssueInput(e.target.value)} onKeyDown={(e) => e.key === "Enter" && addCustomIssue()} />
            <div className="flex gap-2">
              <button onClick={addCustomIssue} className="bg-green-600 text-white px-4 py-2 rounded flex-1">Ajouter</button>
              <button onClick={() => { setShowAddIssue(false); setNewIssueInput(""); }} className="bg-gray-300 px-4 py-2 rounded flex-1">Annuler</button>
            </div>
          </div>
        </div>
      )}

      {showAddCode && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
          <div className="bg-white rounded-xl p-6 w-96">
            <h3 className="text-lg font-bold mb-4">➕ Ajouter un code</h3>
            <input type="text" className="border p-2 rounded w-full mb-4" placeholder="Code téléphone (ex: 1234)" value={newCodeInput} onChange={(e) => setNewCodeInput(e.target.value)} onKeyDown={(e) => e.key === "Enter" && addCustomCode()} />
            <div className="flex gap-2">
              <button onClick={addCustomCode} className="bg-green-600 text-white px-4 py-2 rounded flex-1">Ajouter</button>
              <button onClick={() => { setShowAddCode(false); setNewCodeInput(""); }} className="bg-gray-300 px-4 py-2 rounded flex-1">Annuler</button>
            </div>
          </div>
        </div>
      )}

      {/* MODAL DÉTAIL RÉPARATION */}
      {showDetailModal && selectedRepairDetail && selectedRepairClient && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-xl w-full max-w-2xl max-h-[90vh] overflow-auto">
            <div className="sticky top-0 bg-white p-4 border-b">
              <div className="flex justify-between items-start">
                <div>
                  <div className="flex items-center gap-2 flex-wrap">
                    <h2 className="text-xl font-bold">🔧 Détail réparation MBX-{selectedRepairDetail.id}</h2>
                    <span className={`text-xs px-2 py-1 rounded-full ${
                      selectedRepairDetail.status === "✅ Terminé" ? "bg-green-100 text-green-800" :
                      selectedRepairDetail.status === "🔧 En réparation" ? "bg-blue-100 text-blue-800" :
                      selectedRepairDetail.status === "📦 Rendu" ? "bg-gray-800 text-white" :
                      "bg-yellow-100 text-yellow-800"
                    }`}>
                      {selectedRepairDetail.status || "🟡 Réceptionné"}
                    </span>
                  </div>
                  <p className="text-sm text-gray-500 mt-1">{selectedRepairClient.name}</p>
                </div>
                <button onClick={() => setShowDetailModal(false)} className="text-gray-400 hover:text-gray-600 text-2xl">✕</button>
              </div>
            </div>

            <div className="p-5 space-y-4">
              <div className="bg-gray-50 p-4 rounded-lg">
                <div className="flex items-center gap-2 mb-2">
                  <span className="text-lg">👤</span>
                  <span className="font-semibold">{selectedRepairClient.name}</span>
                </div>
                {selectedRepairClient.phone && selectedRepairClient.phone !== "NC" && (
                  <div className="text-sm text-gray-600">📞 {selectedRepairClient.phone}</div>
                )}
                {selectedRepairClient.email && selectedRepairClient.email !== "NC" && (
                  <div className="text-sm text-gray-600">✉️ {selectedRepairClient.email}</div>
                )}
              </div>

              <div className="border rounded-lg overflow-hidden">
                <div className="grid grid-cols-2 border-b">
                  <div className="p-3 bg-gray-50 font-semibold text-sm">📱 Appareil</div>
                  <div className="p-3 text-sm">{selectedRepairDetail.device}</div>
                </div>
                <div className="grid grid-cols-2 border-b">
                  <div className="p-3 bg-gray-50 font-semibold text-sm">🔧 Panne</div>
                  <div className="p-3 text-sm">{selectedRepairDetail.issue}</div>
                </div>
                {selectedRepairDetail.imei && selectedRepairDetail.imei !== "NC" && (
                  <div className="grid grid-cols-2 border-b">
                    <div className="p-3 bg-gray-50 font-semibold text-sm">🔢 IMEI</div>
                    <div className="p-3 text-sm font-mono">{selectedRepairDetail.imei}</div>
                  </div>
                )}
                {selectedRepairDetail.unlock_code && selectedRepairDetail.unlock_code !== "NC" && (
                  <div className="grid grid-cols-2 border-b">
                    <div className="p-3 bg-gray-50 font-semibold text-sm">🔑 Code téléphone</div>
                    <div className="p-3 text-sm font-mono">{selectedRepairDetail.unlock_code}</div>
                  </div>
                )}
                {selectedRepairDetail.description && selectedRepairDetail.description !== "NC" && (
                  <div className="grid grid-cols-2">
                    <div className="p-3 bg-gray-50 font-semibold text-sm">📝 Description</div>
                    <div className="p-3 text-sm">{selectedRepairDetail.description}</div>
                  </div>
                )}
              </div>

              <div className="border rounded-lg overflow-hidden">
                <div className="grid grid-cols-2 border-b">
                  <div className="p-3 bg-gray-50 font-semibold text-sm">🔍 Diagnostic</div>
                  <div className="p-3 text-sm">{selectedRepairDetail.diagnosis || "Non effectué"}</div>
                </div>
                <div className="grid grid-cols-2">
                  <div className="p-3 bg-gray-50 font-semibold text-sm">🔧 Réparation effectuée</div>
                  <div className="p-3 text-sm">{selectedRepairDetail.repair_description || "Non renseignée"}</div>
                </div>
              </div>

              <div className="border rounded-lg overflow-hidden">
                <div className="grid grid-cols-2">
                  <div className="p-3 bg-gray-50 font-semibold text-sm">💰 Prix final</div>
                  <div className="p-3 text-sm font-bold text-green-600">{selectedRepairDetail.final_price || 0} €</div>
                </div>
              </div>

              <div className="border rounded-lg overflow-hidden">
                <div className="grid grid-cols-2 border-b">
                  <div className="p-3 bg-gray-50 font-semibold text-sm">📅 Date création</div>
                  <div className="p-3 text-sm">{formatDate(selectedRepairDetail.created_at)}</div>
                </div>
                <div className="grid grid-cols-2">
                  <div className="p-3 bg-gray-50 font-semibold text-sm">🔄 Dernière mise à jour</div>
                  <div className="p-3 text-sm">{formatDate(selectedRepairDetail.updated_at)}</div>
                </div>
              </div>

              <div className="flex gap-2 pt-2">
                {(selectedRepairDetail.status === "✅ Terminé" || selectedRepairDetail.status === "📦 Rendu") && (
                  <button
                    onClick={() => {
                      setShowDetailModal(false);
                      setSelectedRepair(selectedRepairDetail);
                      setShowReturnModal(true);
                    }}
                    className="flex-1 bg-amber-600 text-white py-2 rounded-lg text-sm font-medium hover:bg-amber-700"
                  >
                    🔄 Retour SAV
                  </button>
                )}
                <button
                  onClick={() => {
                    setShowDetailModal(false);
                    router.push(`/repairs/${selectedRepairDetail.id}`);
                  }}
                  className="flex-1 bg-blue-600 text-white py-2 rounded-lg text-sm font-medium hover:bg-blue-700"
                >
                  🔧 Modifier
                </button>
                <button
                  onClick={() => setShowDetailModal(false)}
                  className="flex-1 bg-gray-200 text-gray-700 py-2 rounded-lg text-sm font-medium hover:bg-gray-300"
                >
                  Fermer
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </Layout>
  );
}