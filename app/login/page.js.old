"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import { supabase } from "../../lib/supabase";

export default function LoginPage() {
  const router = useRouter();
  const [code, setCode] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  const handleLogin = async (e) => {
    e.preventDefault();
    if (!code || code.length !== 4) {
      setError("Code à 4 chiffres requis");
      return;
    }
    setLoading(true);
    setError("");

    try {
      const { data: technician, error } = await supabase
        .from("technicians")
        .select("*")
        .eq("access_code", code)
        .single();

      if (error || !technician) {
        setError("Code invalide");
        setLoading(false);
        return;
      }

      const isGerant = technician.can_access_technicians === true || 
                       technician.can_access_clients === true;

      sessionStorage.setItem("user", JSON.stringify({
        id: technician.id,
        email: technician.email,
        name: technician.name,
        role: isGerant ? "gerant" : "technicien",
        isGerant: isGerant,
        permissions: {
          dashboard: technician.can_access_dashboard || true,
          repairs: technician.can_access_repairs || true,
          clients: technician.can_access_clients || false,
          historique: technician.can_access_historique || false,
          factures: technician.can_access_factures || false,
          paiements: technician.can_access_paiements || false
        }
      }));

      router.push("/dashboard");

    } catch (err) {
      setError("Erreur");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-black flex items-center justify-center p-4">
      <div className="bg-white rounded-2xl p-8 max-w-md w-full">
        <div className="text-center mb-6">
          <div className="w-16 h-16 bg-orange-500 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-3">🔧</div>
          <h1 className="text-2xl font-bold">MBX Réparations</h1>
          <p className="text-gray-500 text-sm">Connectez-vous avec votre code</p>
        </div>

        <form onSubmit={handleLogin} className="space-y-4">
          <input
            type="text"
            placeholder="Code à 4 chiffres"
            className="w-full text-center text-2xl font-mono tracking-widest border rounded-lg p-4"
            value={code}
            onChange={(e) => setCode(e.target.value.replace(/\D/g, '').slice(0, 4))}
            maxLength={4}
            required
            autoFocus
          />
          {error && <p className="text-red-500 text-sm text-center">{error}</p>}
          <button
            type="submit"
            disabled={loading}
            className="w-full bg-orange-500 text-white py-3 rounded-lg font-semibold"
          >
            {loading ? "..." : "SE CONNECTER"}
          </button>
        </form>
      </div>
    </div>
  );
}